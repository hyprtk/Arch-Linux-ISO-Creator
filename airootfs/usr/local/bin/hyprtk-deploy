#!/bin/bash
###############################################################################
# hyprtk-deploy — install the running hyprtk live system to a disk.
#
# Live-to-disk clone (hyprtk-iso Wayfinder map, ticket "Design the live-to-disk
# deploy script"):
#   * GPT target: 1 MiB bios_grub + 1 GiB FAT32 ESP + ext4 root + 4 GiB swapfile
#   * rsync the live root (keeping /usr, /etc, /etc/skel, /var/lib/pacman)
#   * chroot: UUID fstab, stock initramfs, GRUB (UEFI + BIOS), identity files
#   * removes the live-only user, autologin and passwordless-sudo drop-in
#
# Run from the live session (TTY, or the desktop entry). Needs root.
###############################################################################
set -euo pipefail

SWAP_SIZE="4G"
ESP_SIZE="1GiB"
DEFAULT_HOSTNAME="hyprtk"
DEFAULT_LOCALE="en_US.UTF-8"
MNT="/mnt"

# ── Root ───────────────────────────────────────────────────────────────────
if [ "$(id -u)" -ne 0 ]; then
    exec sudo -E bash "$(readlink -f "$0")" "$@"
fi

LIVE_USER="${SUDO_USER:-hyprtk}"
LIVE_HOME="$(getent passwd "$LIVE_USER" 2>/dev/null | cut -d: -f6)"
[ -n "$LIVE_HOME" ] || LIVE_HOME="/root"
LOG="$LIVE_HOME/hyprtk-deploy.log"
: > "$LOG"

# ── gum ────────────────────────────────────────────────────────────────────
GUM=""
for c in "$(command -v gum 2>/dev/null || true)" \
         /usr/local/bin/gum \
         /etc/skel/hyprtk/installer/standalone/gum; do
    if [ -n "$c" ] && [ -x "$c" ]; then GUM="$c"; break; fi
done

MAGENTA='\033[35m'; CYAN='\033[0;36m'; WHITE='\033[0;37m'
RED='\033[1;31m'; YELLOW='\033[1;33m'; NC='\033[0m'

log()  { printf '[%s] %s\n' "$(date '+%H:%M:%S')" "$*" >> "$LOG"; }
info() { printf "${CYAN}  → ${WHITE}%s${NC}\n" "$*"; log "$*"; }
ok()   { printf "${CYAN}  ✓ ${WHITE}%s${NC}\n" "$*"; log "OK: $*"; }
die()  { printf "${RED}  ✗ ${WHITE}%s${NC}\n" "$*" >&2; log "FATAL: $*"; exit 1; }

box() {
    if [ -n "$GUM" ]; then
        "$GUM" style --border double --border-foreground 5 --align center \
            --padding "1 3" --margin "1 0" "$@"
    else
        printf '\n=== %s ===\n' "$*"
    fi
}
title() { printf "\n${MAGENTA}── %s ──${NC}\n" "$*"; log "STEP: $*"; }
confirm() {
    if [ -n "$GUM" ]; then "$GUM" confirm --prompt.foreground=5 "$1"; else
        read -r -p "$1 [y/N] " _a; [[ "$_a" =~ ^[Yy] ]]; fi
}
ask() { # placeholder, default
    if [ -n "$GUM" ]; then "$GUM" input --value "${2:-}" --placeholder "$1"; else
        read -r -p "$1 [${2:-}] " _a; printf '%s' "${_a:-$2}"; fi
}
askpw() { # placeholder
    if [ -n "$GUM" ]; then "$GUM" input --password --placeholder "$1"; else
        read -r -s -p "$1: " _a; echo >&2; printf '%s' "$_a"; fi
}
spin() { # title, shell-command
    if [ -n "$GUM" ]; then
        "$GUM" spin --spinner dot --title "$1" -- bash -c "$2 >> '$LOG' 2>&1"
    else
        info "$1"; bash -c "$2 >> '$LOG' 2>&1"
    fi
}

# ── Preconditions ──────────────────────────────────────────────────────────
[ -d /run/archiso ] || die "This does not look like the hyprtk live medium."
for cmd in rsync arch-chroot genfstab sgdisk mkfs.fat mkfs.ext4 grub-install; do
    command -v "$cmd" >/dev/null 2>&1 || die "missing required tool: $cmd"
done

LIVE_SRC="$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null || true)"
LIVE_DISK=""
if [ -n "$LIVE_SRC" ]; then
    LIVE_DISK="$(lsblk -no PKNAME "$LIVE_SRC" 2>/dev/null || true)"
    [ -n "$LIVE_DISK" ] && LIVE_DISK="/dev/$LIVE_DISK"
fi
log "live medium: ${LIVE_SRC:-unknown} (disk ${LIVE_DISK:-unknown})"

# ── Target selection ───────────────────────────────────────────────────────
title "Select the target disk"
mapfile -t DISKS < <(lsblk -dpno NAME,SIZE,MODEL,TRAN 2>/dev/null | awk -v live="$LIVE_DISK" 'NF && $1 != live')
[ "${#DISKS[@]}" -gt 0 ] || die "No candidate target disks found."
for d in "${DISKS[@]}"; do printf '    %s\n' "$d"; done

if [ -n "$GUM" ]; then
    CHOICE="$("$GUM" choose --height=12 --cursor.foreground=5 "${DISKS[@]}")"
else
    read -r -p "Target disk (e.g. /dev/sda): " CHOICE
fi
[ -n "$CHOICE" ] || { echo "Aborted."; exit 0; }
TARGET="$(awk '{print $1}' <<< "$CHOICE")"
[ -b "$TARGET" ] || die "not a block device: $TARGET"
[ "$TARGET" != "$LIVE_DISK" ] || die "refusing to install onto the live medium ($TARGET)."

TARGET_SIZE="$(lsblk -dpno SIZE "$TARGET")"
box "THIS WILL ERASE $TARGET" \
    "$TARGET  ($TARGET_SIZE)" \
    "All data on this disk will be destroyed."
if [ -n "$GUM" ]; then
    TYPED="$("$GUM" input --placeholder "type  $TARGET  to confirm")"
else
    read -r -p "Type $TARGET to confirm: " TYPED
fi
[ "$TYPED" = "$TARGET" ] || die "confirmation did not match."

# ── Identity ───────────────────────────────────────────────────────────────
title "Target identity"
HOSTNAME_IN="$(ask 'Hostname' "$DEFAULT_HOSTNAME")"
NEWUSER="$(ask 'Username' "$LIVE_USER")"
TZ_DEF="$(timedatectl show -p Timezone --value 2>/dev/null || echo UTC)"
TZ_IN="$(ask 'Timezone' "$TZ_DEF")"
LOCALE_IN="$(ask 'Locale' "$DEFAULT_LOCALE")"
KEYMAP_DEF="$(localectl status 2>/dev/null | awk -F': ' '/VC Keymap/{print $2}'; true)"
KEYMAP_IN="$(ask 'Console keymap' "${KEYMAP_DEF:-us}")"
ROOTPW="$(askpw 'Root password')"
USERPW="$(askpw "Password for $NEWUSER")"
[ -n "$ROOTPW" ] && [ -n "$USERPW" ] || die "passwords may not be empty."
[ -n "$NEWUSER" ] || die "username may not be empty."

box "READY TO INSTALL" \
    "Target:   $TARGET" \
    "Hostname: $HOSTNAME_IN" \
    "User:     $NEWUSER" \
    "Timezone: $TZ_IN" \
    "Locale:   $LOCALE_IN"
confirm "Begin installation?" || { echo "Aborted."; exit 0; }

cleanup_fail() {
    printf "${RED}  ✗ installation failed — see %s${NC}\n" "$LOG" >&2
    for fs in dev proc sys run; do umount -R "$MNT/$fs" 2>/dev/null || true; done
    umount -R "$MNT" 2>/dev/null || true
    exit 1
}
trap cleanup_fail ERR

# ── Partition ──────────────────────────────────────────────────────────────
title "Partitioning $TARGET"
spin "Creating the GPT partition table..." \
    "sgdisk --zap-all '$TARGET' && \
     sgdisk -n 1:0:+1MiB    -t 1:ef02 -c 1:bios_grub '$TARGET' && \
     sgdisk -n 2:0:+$ESP_SIZE -t 2:ef00 -c 2:ESP      '$TARGET' && \
     sgdisk -n 3:0:0        -t 3:8300 -c 3:root       '$TARGET' && \
     partprobe '$TARGET' && sleep 2"

part() {
    if [[ "$TARGET" =~ [0-9]$ ]]; then printf '%sp%s' "$TARGET" "$1"; else printf '%s%s' "$TARGET" "$1"; fi
}
P_ESP="$(part 2)"
P_ROOT="$(part 3)"
sleep 1
spin "Formatting ESP (FAT32)..."  "mkfs.fat -F32 -n ESP '$P_ESP'"
spin "Formatting root (ext4)..." "mkfs.ext4 -L hyprtk -F '$P_ROOT'"

# ── Mount ──────────────────────────────────────────────────────────────────
title "Mounting the target"
mkdir -p "$MNT"
mount "$P_ROOT" "$MNT"
mkdir -p "$MNT/boot/efi"
mount "$P_ESP" "$MNT/boot/efi"

# ── Clone ──────────────────────────────────────────────────────────────────
title "Cloning the live system (this takes a while)"
spin "rsync live root -> $TARGET..." \
    "rsync -aAXH --info=progress2 \
        --exclude=/proc --exclude=/sys --exclude=/dev --exclude=/run \
        --exclude=/tmp --exclude=$MNT --exclude=/media --exclude=/lost+found \
        --exclude=/var/tmp --exclude='/var/cache/pacman/pkg' --exclude='/var/log/*' \
        --exclude='/home/*' --exclude=/etc/machine-id --exclude=/etc/fstab \
        --exclude=/etc/sudoers.d/10-hyprtk-live \
        --exclude=/etc/sddm.conf.d/10-hyprtk.conf \
        --exclude=/hyprtk-deploy.log \
        / $MNT/"
ok "live system cloned"

# ── fstab / swap ───────────────────────────────────────────────────────────
title "Configuring fstab and swap"
genfstab -U "$MNT" >> "$MNT/etc/fstab"
spin "Creating a $SWAP_SIZE swapfile..." \
    "rm -f '$MNT/swapfile' && fallocate -l $SWAP_SIZE '$MNT/swapfile' && \
     chmod 600 '$MNT/swapfile' && mkswap '$MNT/swapfile' >> '$LOG' 2>&1 && \
     printf '/swapfile none swap defaults 0 0\n' >> '$MNT/etc/fstab'"
# The live medium IS the bootloader read path; never inherit its swap entry.
sed -i '/\/run\/archiso/d' "$MNT/etc/fstab"

# ── Chroot preparation ─────────────────────────────────────────────────────
title "Preparing the chroot"
for fs in dev proc sys run; do mount --rbind "/$fs" "$MNT/$fs"; done

# The live initramfs is built from archiso hooks and will not boot an installed
# system. Restore a stock mkinitcpio.conf before regenerating.
if grep -q 'archiso' "$MNT/etc/mkinitcpio.conf" 2>/dev/null; then
    cat > "$MNT/etc/mkinitcpio.conf" <<'MKINIT'
# vim:set ft=sh
MODULES=()
BINARIES=()
FILES=()
HOOKS=(base udev autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
MKINIT
    ok "restored a stock mkinitcpio.conf (archiso hooks removed)"
fi
spin "Regenerating the initramfs..." "arch-chroot '$MNT' mkinitcpio -P"

# ── Bootloader ─────────────────────────────────────────────────────────────
title "Installing the bootloader (GRUB, UEFI + BIOS)"
spin "GRUB/UEFI..." \
    "arch-chroot '$MNT' grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=GRUB --recheck"
spin "GRUB/BIOS..." \
    "arch-chroot '$MNT' grub-install --target=i386-pc --recheck '$TARGET'"
spin "Generating grub.cfg..." "arch-chroot '$MNT' grub-mkconfig -o /boot/grub/grub.cfg"

# ── Identity ───────────────────────────────────────────────────────────────
title "Writing system identity"
arch-chroot "$MNT" ln -sf "/usr/share/zoneinfo/$TZ_IN" /etc/localtime
arch-chroot "$MNT" hwclock --systohc
printf '%s UTF-8\n' "$LOCALE_IN" > "$MNT/etc/locale.gen"
arch-chroot "$MNT" locale-gen >/dev/null 2>&1
printf 'LANG=%s\n' "$LOCALE_IN" > "$MNT/etc/locale.conf"
printf 'KEYMAP=%s\n' "$KEYMAP_IN" > "$MNT/etc/vconsole.conf"
printf '%s\n' "$HOSTNAME_IN" > "$MNT/etc/hostname"
{
    echo "127.0.0.1 localhost"
    echo "::1       localhost"
    printf '127.0.1.1 %s.localdomain %s\n' "$HOSTNAME_IN" "$HOSTNAME_IN"
} > "$MNT/etc/hosts"
arch-chroot "$MNT" systemd-machine-id-setup >/dev/null 2>&1 || true

title "Creating the user"
if arch-chroot "$MNT" id "$LIVE_USER" >/dev/null 2>&1; then
    arch-chroot "$MNT" userdel -r "$LIVE_USER" >/dev/null 2>&1 \
        || arch-chroot "$MNT" userdel "$LIVE_USER" >/dev/null 2>&1 || true
fi
arch-chroot "$MNT" useradd -m -G wheel -s /bin/zsh "$NEWUSER"
printf '%s:%s\n' "$NEWUSER" "$USERPW" | arch-chroot "$MNT" chpasswd
printf 'root:%s\n' "$ROOTPW" | arch-chroot "$MNT" chpasswd
# An installed box must not keep passwordless sudo.
rm -f "$MNT/etc/sudoers.d/10-hyprtk-live"
printf '%%wheel ALL=(ALL:ALL) ALL\n' > "$MNT/etc/sudoers.d/10-wheel"
chmod 0440 "$MNT/etc/sudoers.d/10-wheel"

title "Enabling services"
for svc in NetworkManager bluetooth sddm systemd-timesyncd; do
    arch-chroot "$MNT" systemctl enable "$svc.service" >/dev/null 2>&1 || true
done
arch-chroot "$MNT" systemctl set-default graphical.target >/dev/null 2>&1 || true

# ── Finish ─────────────────────────────────────────────────────────────────
trap - ERR
cd /
for fs in dev proc sys run; do umount -R "$MNT/$fs" 2>/dev/null || true; done
umount -R "$MNT" 2>/dev/null || true

box "INSTALLATION COMPLETE" \
    "hyprtk is installed on $TARGET" \
    "" \
    "Hostname: $HOSTNAME_IN" \
    "User:     $NEWUSER" \
    "" \
    "Remove the live medium and reboot."
log "installation complete on $TARGET"
