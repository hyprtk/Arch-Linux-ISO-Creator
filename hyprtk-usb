#!/bin/bash
###############################################################################
# hyprtk-usb — write a hyprtk ISO to a USB stick and (optionally) add the
# persistence partition the ISO's "with persistence" boot entry looks for.
#
#   hyprtk-iso Wayfinder map, ticket "Build the hyprtk-usb writer":
#     dd the ISO (iso-hybrid, MBR) -> append a 1 MiB-aligned Linux partition in
#     the stick's free space -> mkfs.ext4 -L hyprtk-persist. The ISO's own two
#     MBR entries (iso9660 type 0x00 + EFI 0xef) are preserved verbatim.
#
# Usage:
#   sudo ./hyprtk-usb --iso <iso> --target /dev/sdX [options]
#   ./hyprtk-usb                       # interactive (asks for both)
#
# Options:
#   -y, --yes            Do not ask for confirmation.
#   --iso FILE           ISO to write (default: newest in ~/Documents/Isos or ~).
#   --target DEV         Whole disk (e.g. /dev/sda); partitions are refused.
#   --no-persist         Write the ISO only; skip the persistence partition.
#   --size SIZE          Persistence size: e.g. 8G, 50%, or "rest" (default).
#   --refresh            Re-write the ISO onto a stick that already has a
#                        hyprtk-persist partition, keeping that partition.
#   --dry-run            Print the plan; change nothing.
#   -h, --help           This help.
#
# Run as your normal user; the script re-execs itself with sudo.
###############################################################################
set -euo pipefail

ORIG_ARGS=("$@")
ISO=""
TARGET=""
DO_PERSIST=1
PERSIST_SIZE="rest"
REFRESH=0
DRY_RUN=0
ASSUME_YES=0
ALIGN=2048            # 1 MiB
PERSIST_LABEL="hyprtk-persist"

MAGENTA='\033[35m'; CYAN='\033[0;36m'; WHITE='\033[0;37m'
RED='\033[1;31m'; YELLOW='\033[1;33m'; NC='\033[0m'
_info() { printf "${CYAN}  -> ${WHITE}%s${NC}\n" "$*"; }
_ok()   { printf "${CYAN}  ok ${WHITE}%s${NC}\n" "$*"; }
_warn() { printf "${YELLOW}  !  ${WHITE}%s${NC}\n" "$*"; }
_die()  { printf "${RED}  x  ${WHITE}%s${NC}\n" "$*" >&2; exit 1; }
_box()  {
    printf "${MAGENTA}+==========================================================+${NC}\n"
    printf "${MAGENTA}|${NC}  ${CYAN}%-56s${NC}${MAGENTA}|${NC}\n" "$1"
    printf "${MAGENTA}+==========================================================+${NC}\n"
}

_usage() { sed -n '2,42p' "$0" | sed 's/^# \{0,1\}//'; }

while [ $# -gt 0 ]; do
    case "$1" in
        -y|--yes)      ASSUME_YES=1 ;;
        --iso)         ISO="${2:?}"; shift ;;
        --target)      TARGET="${2:?}"; shift ;;
        --no-persist)  DO_PERSIST=0 ;;
        --size)        PERSIST_SIZE="${2:?}"; shift ;;
        --refresh)     REFRESH=1 ;;
        --dry-run)     DRY_RUN=1 ;;
        -h|--help)     _usage; exit 0 ;;
        *) _die "unknown option: $1 (try --help)" ;;
    esac
    shift
done

# ── Re-exec as root (dd/sfdisk/mkfs need it) ───────────────────────────────
# HYPRTK_USB_TEST=1 relaxes the device checks and skips the re-exec so the flow
# can be exercised against a plain file (test-only; not a supported mode).
if [ "$(id -u)" -ne 0 ] && [ "${HYPRTK_USB_TEST:-0}" != 1 ]; then
    _info "Root is required to write the device - re-running with sudo..."
    exec sudo bash "$(readlink -f "$0")" ${ORIG_ARGS[@]+"${ORIG_ARGS[@]}"}
fi
REAL_USER="${SUDO_USER:-$(id -un)}"
REAL_HOME="$(getent passwd "$REAL_USER" | cut -d: -f6)"; [ -n "$REAL_HOME" ] || REAL_HOME="/root"

# Size in bytes of a block device or (in test mode) a regular file.
_dev_size() {
    if [ -b "$1" ]; then blockdev --getsize64 "$1"; else stat -c %s "$1"; fi
}

# ── Resolve the ISO ────────────────────────────────────────────────────────
_resolve_iso() {
    [ -n "$ISO" ] && { printf '%s' "$ISO"; return; }
    local d f
    for d in "$REAL_HOME/Documents/Isos" "$REAL_HOME"; do
        [ -d "$d" ] || continue
        f="$(find "$d" -maxdepth 1 -name 'hyprtk-*.iso' -printf '%T@ %p\n' 2>/dev/null \
             | sort -rn | head -1 | cut -d' ' -f2-)"
        [ -n "$f" ] && { printf '%s' "$f"; return; }
    done
}

# ── Checks ─────────────────────────────────────────────────────────────────
_require_tools() {
    local t
    for t in dd sfdisk mkfs.ext4 blockdev lsblk findmnt; do
        command -v "$t" >/dev/null 2>&1 || _die "missing required tool: $t"
    done
}

_check_target() {
    [ -n "$TARGET" ] || _die "no target device (use --target /dev/sdX)"
    if [ "${HYPRTK_USB_TEST:-0}" = 1 ] && [ -f "$TARGET" ]; then
        :
    else
        [ -b "$TARGET" ] || _die "not a block device: $TARGET"
        case "$(lsblk -dno TYPE "$TARGET")" in
            disk|loop) : ;;
            *) _die "target must be a whole disk, not a partition: $TARGET" ;;
        esac

        local mnt
        mnt="$(lsblk -no MOUNTPOINT "$TARGET" | grep -v '^$' || true)"
        [ -z "$mnt" ] || _die "$TARGET has mounted partitions - unmount them first:
$mnt"

        # Never touch the disk that backs / (or its parents).
        local root_src root_disk
        root_src="$(findmnt -no SOURCE / 2>/dev/null || true)"
        if [ -b "$root_src" ]; then
            root_disk="$(lsblk -no PKNAME "$root_src" 2>/dev/null || true)"
            [ -n "$root_disk" ] && root_disk="/dev/$root_disk"
            [ "$TARGET" != "$root_disk" ] || _die "refusing to write the disk backing / ($TARGET)"
        fi
    fi

    local tsize isize
    tsize="$(_dev_size "$TARGET")"
    isize="$(stat -c %s "$ISO")"
    [ "$tsize" -gt "$isize" ] || _die "target ($tsize bytes) is smaller than the ISO ($isize bytes)"
}

_is_hyprtk_iso() {
    local d
    d="$(file -b "$ISO")"
    case "$d" in
        *"ISO 9660"*) : ;;
        *) return 1 ;;
    esac
    # The archiso label is HYPRTK_YYYYMM; require HYPRTK to avoid dd'ing the
    # wrong image onto someone's stick.
    printf '%s' "$(blkid -p -o value -s LABEL "$ISO" 2>/dev/null || true)" | grep -q '^HYPRTK' \
        || file -b "$ISO" | grep -q 'HYPRTK'
}

# ── Plan ───────────────────────────────────────────────────────────────────
# Sets: ISO_SECTORS START_SECTORS END_SECTORS SIZE_SECTORS PERSIST_DEV
_plan() {
    local isize tsize
    isize="$(stat -c %s "$ISO")"
    ISO_SECTORS=$(( (isize + 511) / 512 ))
    tsize="$(_dev_size "$TARGET")"
    TARGET_BYTES="$tsize"
    END_SECTORS=$(( tsize / 512 - 1 ))

    # Start 1 MiB-aligned, at or after the end of the ISO image.
    START_SECTORS=$(( (ISO_SECTORS + ALIGN - 1) / ALIGN * ALIGN ))
    [ "$START_SECTORS" -le "$END_SECTORS" ] \
        || _die "no room after the ISO for a persistence partition"

    local avail=$(( END_SECTORS - START_SECTORS + 1 ))
    case "$PERSIST_SIZE" in
        rest|"")  SIZE_SECTORS=$avail ;;
        *%)       SIZE_SECTORS=$(( avail * ${PERSIST_SIZE%\%} / 100 )) ;;
        *G|*g)    SIZE_SECTORS=$(( ${PERSIST_SIZE%[Gg]} * 1024 * 1024 * 1024 / 512 )) ;;
        *M|*m)    SIZE_SECTORS=$(( ${PERSIST_SIZE%[Mm]} * 1024 * 1024 / 512 )) ;;
        *[!0-9]*) _die "bad --size: $PERSIST_SIZE (use e.g. 8G, 50%, rest)" ;;
        *)        SIZE_SECTORS=$PERSIST_SIZE ;;
    esac
    [ "$SIZE_SECTORS" -ge 2048 ] || _die "persistence partition too small (need >= 1 MiB)"
    [ "$SIZE_SECTORS" -le "$avail" ] || _die "persistence size exceeds free space ($(( avail / 2048 )) MiB)"
    SIZE_SECTORS=$(( SIZE_SECTORS / ALIGN * ALIGN ))

    PERSIST_DEV="$(_part_dev "$( _next_partnum )")"
}

# Partition device path for number $1 (handles the nvme/mmcblk/loop `p` infix).
_part_dev() {
    case "$TARGET" in
        *nvme*|*mmcblk*|*loop*) printf '%sp%s' "$TARGET" "$1" ;;
        *)                      printf '%s%s'  "$TARGET" "$1" ;;
    esac
}

# Smallest free MBR partition number on $TARGET (1-4).
_next_partnum() {
    local n existing
    existing=" $(lsblk -no PARTN "$TARGET" 2>/dev/null | tr '\n' ' ') "
    for n in 1 2 3 4; do
        case "$existing" in *" $n "*) ;; *) printf '%s' "$n"; return ;; esac
    done
    _die "no free partition slot on $TARGET (MBR allows 4)"
}

_existing_persist_geom() {
    # "device start_bytes size_bytes" of a partition labelled $PERSIST_LABEL, else empty
    local p
    for p in $(lsblk -no NAME "$TARGET" 2>/dev/null | tail -n +2); do
        if [ "$(blkid -p -o value -s LABEL "/dev/$p" 2>/dev/null || true)" = "$PERSIST_LABEL" ]; then
            printf '/dev/%s %s %s' "$p" \
                "$(lsblk -bno START "/dev/$p")" "$(lsblk -bno SIZE "/dev/$p")"
            return
        fi
    done
}

# ── Execute ────────────────────────────────────────────────────────────────
_run() {
    _box "PLAN"
    printf "  ISO:    %s\n" "$ISO"
    printf "  Target: %s (%s)\n" "$TARGET" "$(lsblk -dno SIZE,MODEL "$TARGET" 2>/dev/null | xargs || true)"
    printf "  Write:  dd %s -> %s\n" "$ISO" "$TARGET"
    if [ "$DO_PERSIST" -eq 1 ]; then
        printf "  Persist: %s (sectors %s..%s, %s) label %s\n" \
            "$PERSIST_DEV" "$START_SECTORS" "$(( START_SECTORS + SIZE_SECTORS - 1 ))" \
            "$(( SIZE_SECTORS / 2048 )) MiB" "$PERSIST_LABEL"
    else
        printf "  Persist: none\n"
    fi
    echo

    if [ "$DRY_RUN" -eq 1 ]; then _warn "dry run - nothing written"; return 0; fi

    if [ "$ASSUME_YES" -ne 1 ]; then
        printf "${YELLOW}This ERASES %s. Continue? [y/N] ${NC}" "$TARGET"
        read -r reply; [[ "$reply" =~ ^[Yy] ]] || { echo "Aborted."; exit 0; }
    fi

    # Preserve an existing hyprtk-persist partition across a --refresh.
    local old_geom="" old_dev="" old_start_b="" old_size_b=""
    if [ "$REFRESH" -eq 1 ]; then
        old_geom="$(_existing_persist_geom || true)"
        read -r old_dev old_start_b old_size_b <<<"$old_geom"
    fi

    _info "Writing the ISO (this takes a few minutes)..."
    dd if="$ISO" of="$TARGET" bs=4M conv=fsync status=progress
    sync
    # dd truncates a regular file to the ISO size; a block device keeps its size.
    # (test-only; TARGET_BYTES is the pre-dd size)
    [ "${HYPRTK_USB_TEST:-0}" = 1 ] && truncate -s "$TARGET_BYTES" "$TARGET"
    blockdev --rereadpt "$TARGET" 2>/dev/null || true

    if [ "$DO_PERSIST" -eq 0 ]; then
        _ok "ISO written; no persistence partition"
        _box "DONE"; return 0
    fi

    if [ -n "$old_start_b" ]; then
        # Keep the existing geometry exactly (never resize a live filesystem).
        START_SECTORS=$(( old_start_b / 512 ))
        SIZE_SECTORS=$(( old_size_b / 512 ))
        [ "$START_SECTORS" -ge "$ISO_SECTORS" ] \
            || _die "existing persistence partition overlaps the new ISO - back it up and write fresh"
        PERSIST_DEV="$old_dev"
        _info "Preserving existing persistence partition $PERSIST_DEV at sector $START_SECTORS"
    fi

    _info "Adding the persistence partition ${PERSIST_DEV}..."
    printf 'start=%s, size=%s, type=83\n' "$START_SECTORS" "$SIZE_SECTORS" \
        | sfdisk --append "$TARGET"
    blockdev --rereadpt "$TARGET" 2>/dev/null || true

    if [ -n "$old_start_b" ]; then
        _ok "Persistence partition re-attached (existing data kept)"
    elif [ "${HYPRTK_USB_TEST:-0}" = 1 ]; then
        _ok "test mode: skipping mkfs (no partition device for a plain file)"
    else
        _info "Formatting ${PERSIST_DEV} as ext4 (label ${PERSIST_LABEL})..."
        mkfs.ext4 -F -L "$PERSIST_LABEL" "$PERSIST_DEV"
        _ok "Persistence partition ready"
    fi

    _box "DONE"
    printf "${WHITE}  Boot the stick and pick ${CYAN}Hyprtk live with persistence${WHITE}.${NC}\n"
    printf "${WHITE}  Ephemeral boots are unaffected if you pick the default entry.${NC}\n"
}

_require_tools
ISO="$(_resolve_iso)"
[ -n "$ISO" ] && [ -f "$ISO" ] || _die "no ISO found (use --iso <file>)"
_is_hyprtk_iso || _warn "this does not look like a hyprtk ISO; continuing may be wrong"
_check_target
_plan
_run
